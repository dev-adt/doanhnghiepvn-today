# ==============================================================================
# DOANHNGHIEPVN.TODAY - ENVIRONMENT CONFIGURATION
# Sao chép file này thành .env và điền các giá trị phù hợp với môi trường của bạn.
# ==============================================================================

# Cấu hình Server
PORT=3024
NODE_ENV=production
SITE_URL=https://doanhnghiepvn.today
DEMO_SITE_URL=https://demo.edunow.today
JWT_SECRET=your_super_secret_jwt_key_please_change_in_production_2026

# Cấu hình Thương hiệu (Brand Identity)
APP_NAME=DoanhNghiepVN.today Platform
BRAND_NAME=DoanhNghiepVN.today
BRAND_SHORT_NAME=DoanhNghiepVN
AI_AGENT_NAME=AI Doanh Nghiệp VN
SUPPORT_EMAIL=contact@doanhnghiepvn.today

# Cấu hình Cơ sở dữ liệu MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=doanhnghiepvn_db

# Cấu hình Trí tuệ Nhân tạo Google Gemini (AI Chat & RAG)
GEMINI_API_KEY=your_gemini_api_key_here

# Cấu hình Gửi Email SMTP (Xác thực, Quên mật khẩu, Thông báo duyệt)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_NAME=Ban Biên Tập DoanhNghiepVN.today
SMTP_FROM="DoanhNghiepVN.today" <your_email@gmail.com>
